# Copy to .env (gitignored). Never put keys in frontend code.

# --- Product lookup ("Find online" in the closet: product_lookup.jac) and spikes/scan_test.py ---
# SerpApi: Image API upload + Google Lens reverse image search
SERPAPI_KEY=your_serpapi_key
# Anthropic: Claude vision picks the closest-looking product photo among the Lens results
ANTHROPIC_API_KEY=your_anthropic_key
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
# visual_matches is the Lens type that returns shopping results with prices
LENS_TYPE=visual_matches
# isnet-general-use is ~3 s/photo on CPU; birefnet-general is far sharper but ~10 min/photo on an Intel Mac
REMBG_MODEL=isnet-general-use

# --- Try-on spike (spikes/tryon_test.py): Google Vertex AI Virtual Try-On ---
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Clothing metadata analyzer (clothing_ai.jac) ---
# Default provider is Claude (uses ANTHROPIC_API_KEY and CLAUDE_MODEL above).
# Set to "gemini" to use the Gemini path instead.
CLOTHING_AI_PROVIDER=claude
# Gemini (only needed when CLOTHING_AI_PROVIDER=gemini)
GEMINI_API_KEY=your_google_ai_studio_key
# Optional. The app defaults to the current Gemini Flash model.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
