# Copy to .env (gitignored). Never put keys in frontend code.

# --- Product lookup ("Find online" in the closet: product_lookup.jac) and spikes/scan_test.py ---
# SerpApi: Image API upload + Google Lens reverse image search
SERPAPI_KEY=your_serpapi_key
# Anthropic: shared by clothing analysis, outfit recommendations, chat, and product matching
ANTHROPIC_API_KEY=your_anthropic_key
# Optional model override used by every Claude feature
CLAUDE_MODEL=claude-opus-5-5
# Optional per-installation usage limits (the window defaults to one hour)
TYYLI_CLAUDE_GLOBAL_DAILY_LIMIT=500
TYYLI_RATE_LIMIT_WINDOW_SECONDS=3600
TYYLI_RATE_LIMIT_ANALYZE=30
TYYLI_RATE_LIMIT_RECOMMEND=30
TYYLI_RATE_LIMIT_EXPLAIN=30
TYYLI_RATE_LIMIT_PRODUCT_LOOKUP=30
TYYLI_RATE_LIMIT_CHAT=100
TYYLI_RATE_LIMIT_STYLE_IDENTITY=30
# visual_matches is the Lens type that returns shopping results with prices
LENS_TYPE=visual_matches
# isnet-general-use is ~3 s/photo on CPU; birefnet-general is far sharper but ~10 min/photo on an Intel Mac
REMBG_MODEL=isnet-general-use

# --- Try-on spike (spikes/tryon_test.py): Google Vertex AI Virtual Try-On ---
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
